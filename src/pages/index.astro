---
import BaseLayout from '../layouts/BaseLayout.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import OpenNowBadge from '../components/OpenNowBadge.astro';
import TonightCard from '../components/TonightCard.astro';
import EventCard from '../components/EventCard.astro';
import PastEvents from '../components/PastEvents.astro';
import WeeklyCard from '../components/WeeklyCard.astro';
import HoursTable from '../components/HoursTable.astro';
import MapEmbed from '../components/MapEmbed.astro';
import FacebookCTA from '../components/FacebookCTA.astro';
import VinylDivider from '../components/VinylDivider.astro';
import Placeholder from '../components/Placeholder.astro';
import { site, weekly, datedEvents, confirmedWeekly, photos, u, isPlaceholder } from '../lib/site';

const approved = (f: string) => photos.find((p) => p.file === f)?.approved === true;
const alt = (f: string) => photos.find((p) => p.file === f)!.alt;
// Home §5 strip: Google photos are approval-gated; fallbacks per build script 9.1.
const strip = [
  approved('google-maps/gmaps-05-cocktail-on-vinyl-record-bartop.jpg') ? 'google-maps/gmaps-05-cocktail-on-vinyl-record-bartop.jpg' : 'website/carousel-02-orange-cocktail-with-cherry.jpg',
  'website/carousel-04-bar-counter-neon-band-playing.jpg',
  approved('google-maps/gmaps-03-vintage-poster-wall-behind-bar.jpg') ? 'google-maps/gmaps-03-vintage-poster-wall-behind-bar.jpg' : 'website/carousel-07-band-red-stage-light.jpg',
  'website/carousel-06-acoustic-band-purple-light.jpg',
];
const today = new Date().toISOString().slice(0, 10);
const upcoming = datedEvents.filter((e) => e.date >= today).sort((a, b) => a.date.localeCompare(b.date)).slice(0, 3);
const karaokeConfirmed = weekly.some((w) => w.type === 'karaoke' && w.confirmed);
const title = karaokeConfirmed ? "Roxy's Restobar | Live Music, Karaoke & Drinks on Main St, Stoughton WI" : "Roxy's Restobar | Bar & Live Music on Main St, Stoughton, WI";
const unconfirmed = weekly.filter((w) => !w.confirmed);
---
<BaseLayout title={title} current="home" path="/"
  description="Roxy's Restobar, 208 W Main St, Stoughton, WI. Music events, open mics, Every Thursday @ 7 Chip Draw and Meat Raffle. Call (608) 480-7007.">
  <!-- Section 1: Hero -->
  <section class="relative flex min-h-[88svh] items-end overflow-hidden lg:min-h-[78vh]">
    <div class="absolute inset-0">
      <Img src="website/carousel-01-karaoke-crowd-at-bar.jpg" alt="Crowd gathered around the neon-lit bar at Roxy's Restobar" eager sizes="100vw" widths={[400, 800, 1080]}
        class="h-full w-full object-cover [object-position:50%_40%] [filter:saturate(1.05)_contrast(1.03)]" pictureClass="block h-full" />
    </div>
    <div class="banner-texture opacity-10" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-night via-night/70 to-night/5" aria-hidden="true"></div>
    <div class="relative container-x pb-24 pt-28 md:pb-28">
      <OpenNowBadge />
      <h1 class="mt-4 text-cream drop-shadow-[0_3px_18px_rgb(0_0_0/.6)]">Roxy's Restobar</h1>
      <p class="mt-2 text-lg font-bold text-cream/90 md:text-xl">208 W Main St · Stoughton, WI</p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a href={site.directions} target="_blank" rel="noopener" class="btn btn-primary w-full sm:w-auto"><Icon name="navigation" size={20} />Get Directions<span class="sr-only"> (opens in new tab)</span></a>
        <a href={`tel:${site.tel}`} class="btn btn-outline w-full sm:w-auto"><Icon name="phone" size={20} />Call {site.phone}</a>
      </div>
      <a href={u('/events')} class="link-arrow mt-3">See what's on <Icon name="arrow-right" size={18} /></a>
      {isPlaceholder(site.tagline) && <Placeholder class="mt-3 max-w-md" note="optional one-line tagline from business" />}
    </div>
  </section>

  <!-- Section 2: Tonight / Up next (overlaps hero by 48px) -->
  <div class="relative z-10 container-x -mt-12"><TonightCard /></div>

  <!-- Section 3: Music Events -->
  <section class="section" aria-labelledby="music-events">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="music-events" class="text-music-blue-300">Music Events</h2>
        <a href={u('/events')} class="link-arrow">See all events <Icon name="arrow-right" size={18} /></a>
      </div>
      {upcoming.length ? (
        <div class="mt-8 grid gap-4 md:grid-cols-3">{upcoming.map((e: any) => <EventCard {...e} />)}</div>
      ) : (
        <div class="mt-8 grid gap-6 lg:grid-cols-[1fr_1.2fr] lg:items-start">
          <div class="card p-6">
            <p class="eyebrow text-vinyl-orange">This week</p>
            <p class="mt-1 text-xl font-black text-cream">Follow us on Facebook for this week's lineup</p>
            <a href={site.facebook} target="_blank" rel="noopener" class="btn btn-primary mt-4"><Icon name="facebook" size={20} />Follow on Facebook<span class="sr-only"> (opens in new tab)</span></a>
            <Placeholder class="mt-4" note="current events lineup with dates and times" />
          </div>
          <PastEvents strip />
        </div>
      )}
    </div>
  </section>

  <VinylDivider color="#F2A541" />

  <!-- Section 4: Every week -->
  <section class="section" aria-labelledby="every-week">
    <div class="container-x">
      <h2 id="every-week" class="text-cream">Every week</h2>
      <div class="snap-row mt-8 md:grid md:grid-cols-3 md:overflow-visible" tabindex="0" role="region" aria-label="Weekly nights (scrolls sideways)">
        {confirmedWeekly.map((w) => <WeeklyCard label={w.label} title={w.title} type={w.type} class="w-[85%] md:w-auto" />)}
        {unconfirmed.map((w) => (
          <div class="card w-[85%] border-dashed p-6 md:w-auto">
            <p class="eyebrow text-muted">Seen on Facebook · not yet confirmed</p>
            <p class="mt-2 font-black text-cream">{w.label}</p>
            <Placeholder class="mt-3" note={w.flag!} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 5: The room -->
  <section class="section bg-night-2/50" aria-labelledby="inside">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 id="inside" class="text-cream">Inside Roxy's</h2>
          <p class="mt-2 eyebrow text-lavender">Vinyl-record bar top · vintage poster wall · live music</p>
        </div>
        <a href={u('/photos')} class="link-arrow">See all photos <Icon name="arrow-right" size={18} /></a>
      </div>
      <Placeholder class="mt-4 max-w-2xl" note="1-2 sentences from business about the bar" />
      <ul class="snap-row mt-8 md:grid md:grid-cols-4 md:overflow-visible" tabindex="0" aria-label="Photos from inside Roxy's (scrolls sideways)">
        {strip.map((f) => (
          <li class="w-[70%] md:w-auto"><Img src={f} alt={alt(f)} sizes="(min-width:768px) 25vw, 70vw" widths={[400, 800]} class="photo aspect-[3/4] w-full object-cover" /></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Section 6: Visit -->
  <section class="section" aria-labelledby="visit" id="hours">
    <div class="container-x grid gap-8 lg:grid-cols-2">
      <div>
        <h2 id="visit" class="text-cream">Visit</h2>
        <div class="card mt-6 p-3"><HoursTable /></div>
        {!site.hoursConfirmed && <p class="mt-2 text-sm text-muted">Hours from our Google listing</p>}
        {!site.hoursConfirmed && <Placeholder class="mt-3" note={site.hoursNote} />}
        <address class="mt-6 not-italic text-lg font-bold text-cream">{site.address.street}<br />{site.address.city}, {site.address.state} {site.address.zip}</address>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href={site.directions} target="_blank" rel="noopener" class="btn btn-primary"><Icon name="navigation" size={20} />Get Directions<span class="sr-only"> (opens in new tab)</span></a>
          <a href={`tel:${site.tel}`} class="btn btn-outline"><Icon name="phone" size={20} />Call {site.phone}</a>
        </div>
      </div>
      <div class="lg:pt-[72px]"><MapEmbed /></div>
    </div>
  </section>

  <!-- Section 7: Facebook -->
  <section class="pb-14 lg:pb-24"><div class="container-x"><FacebookCTA /></div></section>
</BaseLayout>
