---
import BaseLayout from '../layouts/BaseLayout.astro';
import VinylDivider from '../components/VinylDivider.astro';
import Placeholder from '../components/Placeholder.astro';
import { u } from '../lib/site';
---
<BaseLayout title="Page not found | Roxy's Restobar" description="That page doesn't exist. Head back to Roxy's Restobar." path="/404" current="" noindex>
  <section class="section">
    <div class="container-x flex flex-col items-center text-center">
      <p class="eyebrow neon">404</p>
      <h1 class="mt-4 text-cream">This track skipped.</h1>
      <Placeholder class="mt-5" note="copy approval" />
      <VinylDivider skip class="mt-10 max-w-md" />
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={u('/')} class="btn btn-primary">Home</a>
        <a href={u('/events')} class="btn btn-outline">Events</a>
        <a href={u('/visit')} class="btn btn-outline">Visit</a>
      </div>
    </div>
  </section>
</BaseLayout>
