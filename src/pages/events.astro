---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import EventCard from '../components/EventCard.astro';
import PastEvents from '../components/PastEvents.astro';
import WeeklyCard from '../components/WeeklyCard.astro';
import FacebookCTA from '../components/FacebookCTA.astro';
import Placeholder from '../components/Placeholder.astro';
import Icon from '../components/Icon.astro';
import { site, weekly, datedEvents, confirmedWeekly, abs } from '../lib/site';

const today = new Date().toISOString().slice(0, 10);
const upcoming = datedEvents.filter((e) => e.date >= today).sort((a, b) => a.date.localeCompare(b.date));
const byMonth = Object.entries(upcoming.reduce<Record<string, typeof upcoming>>((acc, e) => {
  const k = new Date(e.date + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', year: 'numeric' }); (acc[k] ||= []).push(e); return acc;
}, {}));
const unconfirmed = weekly.filter((w) => !w.confirmed);
// MusicEvent schema only for dated, confirmed events (never for placeholder dates).
const eventSchema = upcoming.map((e: any) => ({
  '@context': 'https://schema.org', '@type': 'MusicEvent', name: e.title, startDate: e.time ? `${e.date}T${e.time}` : e.date,
  eventStatus: 'https://schema.org/EventScheduled', eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: { '@type': 'BarOrPub', '@id': abs('/') + '#bar', name: site.name, address: `${site.address.street}, ${site.address.city}, ${site.address.state} ${site.address.zip}` },
}));
const fbFeed = `https://www.facebook.com/plugins/page.php?href=${encodeURIComponent(site.facebook)}&tabs=timeline&width=500&height=640&small_header=true&hide_cover=false`;
---
<BaseLayout title="Music Events & Weekly Nights | Roxy's Restobar, Stoughton WI" current="events" path="/events" og="/og/events.jpg"
  description="Upcoming music events at Roxy's Restobar on Main St in Stoughton: open mics, bands, DJs and sing-alongs, plus Every Thursday @ 7 Chip Draw and Meat Raffle.">
  {eventSchema.length > 0 && <script slot="head" type="application/ld+json" set:html={JSON.stringify(eventSchema)} />}
  <PageHero title="Music Events" eyebrow="Roxy's Restobar · Stoughton" />

  <!-- A: Upcoming -->
  <section class="section !pt-10" aria-labelledby="upcoming">
    <div class="container-x">
      <h2 id="upcoming" class="text-music-blue-300">Upcoming</h2>
      {byMonth.length ? byMonth.map(([month, list]) => (
        <div class="mt-8">
          <h3 class="eyebrow !text-sm text-lavender">{month}</h3>
          <div class="mt-4 grid gap-4 md:grid-cols-2 lg:grid-cols-3">{list.map((e: any) => <EventCard {...e} />)}</div>
        </div>
      )) : (
        <div class="card mt-6 max-w-2xl p-6">
          <p class="text-xl font-black text-cream">Follow us on Facebook for this week's lineup</p>
          <a href={site.facebook} target="_blank" rel="noopener" class="btn btn-primary mt-4"><Icon name="facebook" size={20} />Follow on Facebook<span class="sr-only"> (opens in new tab)</span></a>
          <Placeholder class="mt-4" note="current events lineup with dates and times (add them to src/content/events.json)" />
        </div>
      )}
    </div>
  </section>

  <!-- B: Every week -->
  <section class="section !pt-0" aria-labelledby="weekly">
    <div class="container-x">
      <h2 id="weekly" class="text-cream">Every week</h2>
      <div class="snap-row mt-8 md:grid md:grid-cols-3 md:overflow-visible" tabindex="0" role="region" aria-label="Weekly nights (scrolls sideways)">
        {confirmedWeekly.map((w) => <WeeklyCard label={w.label} title={w.title} type={w.type} class="w-[85%] md:w-auto" />)}
        {unconfirmed.map((w) => (
          <div class="card w-[85%] border-dashed p-6 md:w-auto">
            <p class="eyebrow text-muted">Seen on Facebook · not yet confirmed</p>
            <p class="mt-2 font-black text-cream">{w.label}</p>
            <Placeholder class="mt-3" note={w.flag!} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- C: Past events -->
  <section class="section !pt-0" aria-labelledby="past">
    <div class="container-x max-w-3xl">
      <details class="group card p-0" open>
        <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-3 px-5 py-3">
          <h2 id="past" class="!font-sans !text-xl font-black text-cream">Past events</h2>
          <Icon name="chevron-right" size={22} class="text-lavender transition-transform group-open:rotate-90" />
        </summary>
        <div class="px-4 pb-5">
          <p class="mb-3 text-sm text-muted">From our previous website. These dates had no year listed.</p>
          <PastEvents />
          <Placeholder class="mt-3" note="year? (old list is stale; replace with the current lineup)" />
        </div>
      </details>
    </div>
  </section>

  <!-- D: Stay in the loop -->
  <section class="section !pt-0" aria-labelledby="loop">
    <div class="container-x">
      <h2 id="loop" class="sr-only">Stay in the loop</h2>
      <FacebookCTA showArt={false} />
      <div class="mt-6 text-center" data-fb-feed data-src={fbFeed}>
        <button type="button" class="btn btn-outline"><Icon name="facebook" size={20} />Show our latest Facebook posts</button>
        <p class="mt-2 text-xs text-muted">Loads Facebook's feed only when you tap.</p>
      </div>
    </div>
  </section>

  <!-- E: Perform at Roxy's? (only if the business confirms) -->
  <section class="section !pt-0"><div class="container-x max-w-3xl">
    <Placeholder note="does the business want booking/open-mic sign-up info? contact method? (Perform at Roxy's? section)" />
  </div></section>
</BaseLayout>
