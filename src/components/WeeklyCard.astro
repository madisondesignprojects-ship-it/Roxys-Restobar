---
import Icon from './Icon.astro';
import { TYPE_LABELS } from '../lib/site';
interface Props { label: string; title: string; type: string; class?: string }
const { label, title, type, class: cls = '' } = Astro.props;
const t = TYPE_LABELS[type] ?? { icon: 'calendar' };
---
<article class={`card card-hover relative overflow-hidden p-6 md:p-7 ${cls}`}>
  <div class="halftone opacity-50" aria-hidden="true"></div>
  <div class="relative flex items-center justify-between gap-3">
    <span class="eyebrow text-label-gold">{label}</span>
    <Icon name={t.icon} size={22} class="text-dim" />
  </div>
  <h3 class="relative mt-6 font-display text-[2.1rem] font-normal uppercase leading-[.95] text-cream">{title}</h3>
</article>
