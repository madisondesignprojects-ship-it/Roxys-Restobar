---
// Visible "[PLACEHOLDER]" marker (build script 0.3 / 7.13). Shown in this demo build on purpose;
// `npm run build:launch` fails while any remain in dist/.
import { phNote } from '../lib/site';
interface Props { note: string; inline?: boolean; class?: string }
const { note, inline = false, class: cls = '' } = Astro.props;
const text = `[PLACEHOLDER - ${phNote(note)}]`;
---
{inline
  ? <span class={`placeholder-inline ${cls}`} data-placeholder>{text}</span>
  : <div class={`placeholder-box ${cls}`} role="note" data-placeholder>{text}</div>}
