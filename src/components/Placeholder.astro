---
// Open questions for the business. Hidden on the live site by default (commit d955413);
// the `note` prop stays in the source as a to-do list. Find them with `rg "<Placeholder"`.
// Set PUBLIC_SHOW_PLACEHOLDERS=1 at build time to render them as muted dashed "[PLACEHOLDER - ...]" notes
// (review builds); `npm run build:launch` still fails if any are rendered.
import { phNote, SHOW_PH } from '../lib/site';
interface Props { note: string; inline?: boolean; class?: string }
const { note, inline = false, class: cls = '' } = Astro.props;
const show = SHOW_PH;
const text = `[PLACEHOLDER - ${phNote(note)}]`;
---
{show && (inline
  ? <span class={`placeholder-inline ${cls}`} data-placeholder>{text}</span>
  : <div class={`placeholder-box ${cls}`} role="note" data-placeholder>{text}</div>)}
