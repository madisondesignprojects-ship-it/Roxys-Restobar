---
import Icon from './Icon.astro';
import { site, u } from '../lib/site';
const cls = 'mono flex min-h-[60px] flex-col items-center justify-center gap-1 text-[.68rem] uppercase tracking-[.16em] text-cream no-underline';
---
<nav aria-label="Quick actions" class="sticky-bar fixed inset-x-0 bottom-0 z-30 border-t border-rule bg-night/95 pb-[env(safe-area-inset-bottom)] backdrop-blur md:hidden">
  <ul class="grid grid-cols-3 divide-x divide-rule">
    <li><a href={`tel:${site.tel}`} class={cls}><Icon name="phone" size={20} class="text-lavender" />Call</a></li>
    <li><a href={site.directions} target="_blank" rel="noopener" class={cls}><Icon name="navigation" size={20} class="text-lavender" />Directions<span class="sr-only"> (opens in new tab)</span></a></li>
    <li><a href={u('/events')} class={cls}><Icon name="calendar" size={20} class="text-lavender" />Events</a></li>
  </ul>
</nav>
