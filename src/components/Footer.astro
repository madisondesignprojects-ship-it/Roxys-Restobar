---
import Wordmark from './Wordmark.astro';
import HoursTable from './HoursTable.astro';
import Icon from './Icon.astro';
import Placeholder from './Placeholder.astro';
import { site, isPlaceholder } from '../lib/site';
const year = new Date().getFullYear();
const h = 'eyebrow text-dim';
---
<footer class="relative overflow-hidden border-t border-rule bg-[#08060C]">
  <div class="halftone opacity-30" aria-hidden="true"></div>
  <div class="relative container-x grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <Wordmark size="lg" />
      {isPlaceholder(site.tagline)
        ? <><p class="mono mt-5 text-sm text-muted">208 W Main St · Stoughton, WI</p><Placeholder class="mt-3" note={site.tagline} /></>
        : <p class="mt-5 text-muted">{site.tagline}</p>}
    </div>
    <div>
      <h2 class={h}>Visit</h2>
      <address class="mt-3 not-italic text-cream">{site.address.street}<br />{site.address.city}, {site.address.state} {site.address.zip}</address>
      <a href={site.directions} target="_blank" rel="noopener" class="link-arrow"><Icon name="navigation" size={16} />Directions<span class="sr-only"> (opens in new tab)</span></a>
      <p class="mono text-xs text-dim">Plus code WQ8H+Q6</p>
    </div>
    <div>
      <h2 class={h}>Hours</h2>
      <HoursTable compact class="mt-2" />
      {!site.hoursConfirmed && <p class="mt-2 text-xs text-dim">Hours from our Google listing.</p>}
    </div>
    <div>
      <h2 class={h}>Contact &amp; follow</h2>
      <ul class="mt-3 space-y-1">
        <li><a href={`tel:${site.tel}`} class="inline-flex min-h-[44px] items-center gap-2 font-semibold text-cream no-underline hover:text-lavender"><Icon name="phone" size={16} />{site.phone}</a></li>
        <li><a href={site.facebook} target="_blank" rel="noopener" class="inline-flex min-h-[44px] items-center gap-2 font-semibold text-cream no-underline hover:text-lavender"><Icon name="facebook" size={16} />Facebook<span class="sr-only"> (opens in new tab)</span></a></li>
        <li>{isPlaceholder(site.email) ? <span class="text-sm text-muted">Email: <Placeholder inline note={site.email} /></span> : <a href={`mailto:${site.email}`}>{site.email}</a>}</li>
      </ul>
    </div>
  </div>
  <div class="relative border-t border-rule">
    <div class="container-x mono flex flex-col gap-2 py-5 text-xs uppercase tracking-[.12em] text-dim sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Roxy's Restobar</p>
      <p class="normal-case tracking-normal">Please drink responsibly. <Placeholder inline note="business may prefer different wording or none" /></p>
    </div>
  </div>
</footer>
