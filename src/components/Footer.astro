---
import Wordmark from './Wordmark.astro';
import HoursTable from './HoursTable.astro';
import Icon from './Icon.astro';
import Placeholder from './Placeholder.astro';
import { site, isPlaceholder } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="relative overflow-hidden border-t border-night-3 bg-night-2">
  <div class="banner-texture opacity-15" aria-hidden="true"></div>
  <div class="relative container-x grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <Wordmark />
      {isPlaceholder(site.tagline)
        ? <><p class="mt-4 text-muted">208 W Main St · Stoughton, WI</p><Placeholder class="mt-3" note={site.tagline} /></>
        : <p class="mt-4 text-muted">{site.tagline}</p>}
    </div>
    <div>
      <h2 class="eyebrow font-sans text-lavender !text-[.8rem]">Visit</h2>
      <address class="mt-3 not-italic text-cream">{site.address.street}<br />{site.address.city}, {site.address.state} {site.address.zip}</address>
      <a href={site.directions} target="_blank" rel="noopener" class="link-arrow"><Icon name="navigation" size={18} />Directions<span class="sr-only"> (opens in new tab)</span></a>
      <p class="text-sm text-muted">Plus code WQ8H+Q6</p>
    </div>
    <div>
      <h2 class="eyebrow font-sans text-lavender !text-[.8rem]">Hours</h2>
      <HoursTable compact class="mt-2" />
      {!site.hoursConfirmed && <p class="mt-2 text-xs text-muted">Hours from our Google listing.</p>}
    </div>
    <div>
      <h2 class="eyebrow font-sans text-lavender !text-[.8rem]">Contact &amp; follow</h2>
      <ul class="mt-3 space-y-1">
        <li><a href={`tel:${site.tel}`} class="inline-flex min-h-[44px] items-center gap-2 font-bold text-cream no-underline hover:text-lavender"><Icon name="phone" size={18} />{site.phone}</a></li>
        <li><a href={site.facebook} target="_blank" rel="noopener" class="inline-flex min-h-[44px] items-center gap-2 font-bold text-cream no-underline hover:text-lavender"><Icon name="facebook" size={18} />Facebook<span class="sr-only"> (opens in new tab)</span></a></li>
        <li>{isPlaceholder(site.email) ? <span class="text-sm">Email: <Placeholder inline note={site.email} /></span> : <a href={`mailto:${site.email}`}>{site.email}</a>}</li>
      </ul>
    </div>
  </div>
  <div class="relative border-t border-night-3">
    <div class="container-x flex flex-col gap-2 py-5 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Roxy's Restobar</p>
      <p>Please drink responsibly. <Placeholder inline note="business may prefer different wording or none" /></p>
    </div>
  </div>
</footer>
