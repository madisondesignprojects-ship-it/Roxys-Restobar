---
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import HoursTable from './HoursTable.astro';
import { site, u } from '../lib/site';
interface Props { current: string }
const { current } = Astro.props;
const links = [{ href: '/', label: 'Home', key: 'home' }, { href: '/events', label: 'Events', key: 'events' }, { href: '/photos', label: 'Photos', key: 'photos' }, { href: '/visit', label: 'Visit', key: 'visit' }];
---
<div id="mobile-menu" class="fixed inset-0 z-50 hidden overflow-y-auto bg-night lg:hidden" role="dialog" aria-modal="true" aria-label="Menu" data-menu>
  <div class="halftone opacity-40" aria-hidden="true"></div>
  <div class="relative container-x flex h-16 items-center justify-between border-b border-rule">
    <Wordmark />
    <button type="button" class="inline-flex h-12 w-12 items-center justify-center text-cream hover:text-lavender" aria-label="Close menu" data-menu-close><Icon name="x" size={28} /></button>
  </div>
  <nav aria-label="Mobile" class="relative container-x pt-2">
    <ul>
      {links.map((l, i) => (
        <li><a href={u(l.href)} aria-current={current === l.key ? 'page' : undefined} class={`flex min-h-[64px] items-baseline gap-4 border-b border-rule no-underline ${current === l.key ? 'text-lavender' : 'text-cream'}`}>
          <span class="mono text-xs text-dim">0{i + 1}</span><span class="font-display text-4xl uppercase">{l.label}</span></a></li>
      ))}
    </ul>
    <div class="mt-6 grid gap-3">
      <a href={`tel:${site.tel}`} class="btn btn-primary min-h-[56px]"><Icon name="phone" size={18} />Call {site.phone}</a>
      <a href={site.directions} target="_blank" rel="noopener" class="btn btn-outline min-h-[56px]"><Icon name="navigation" size={18} />Get Directions<span class="sr-only"> (opens in new tab)</span></a>
      <a href={site.facebook} target="_blank" rel="noopener" class="btn btn-outline min-h-[56px]"><Icon name="facebook" size={18} />Facebook<span class="sr-only"> (opens in new tab)</span></a>
    </div>
    <div class="mt-8 mb-10 border-t border-rule pt-4">
      <p class="eyebrow pb-2 text-dim">Hours</p>
      <HoursTable compact />
    </div>
  </nav>
</div>
