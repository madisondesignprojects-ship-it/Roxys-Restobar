---
// 7.6 gig-poster card. Expects a dated event (ISO date) – placeholder-dated events use the Past list.
import Icon from './Icon.astro';
import Placeholder from './Placeholder.astro';
import { TYPE_LABELS, fmtTime } from '../lib/site';
interface Props { title: string; date: string; type: string; time?: string; note?: string }
const { title, date, type, time, note } = Astro.props;
const d = new Date(date + 'T12:00:00');
const mon = d.toLocaleDateString('en-US', { month: 'short' });
const t = TYPE_LABELS[type] ?? { label: type, icon: 'music', tone: 'blue' };
---
<article class="card card-hover flex gap-4 p-4 md:p-5">
  <div class="flex w-16 shrink-0 flex-col items-center justify-center rounded-xl border border-night-3 bg-night py-2 text-music-blue-300">
    <span class="eyebrow">{mon}</span><span class="font-display text-3xl leading-none">{d.getDate()}</span>
  </div>
  <div class="min-w-0">
    <span class={`tag tag-${t.tone}`}><Icon name={t.icon} size={14} />{t.label}</span>
    <h3 class="mt-2 text-cream">{title}</h3>
    <p class="text-muted">{time ? fmtTime(time) : <Placeholder inline note="event times" />}</p>
    {note && <p class="text-sm text-muted">{note}</p>}
  </div>
</article>
