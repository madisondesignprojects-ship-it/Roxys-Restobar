---
import Icon from './Icon.astro';
import Placeholder from './Placeholder.astro';
interface Props { icon: string; title: string; value?: string; flag?: string }
const { icon, title, value, flag } = Astro.props;
---
<article class="card p-5">
  <div class="flex items-center gap-3">
    <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-roxy-purple/20 text-lavender"><Icon name={icon} size={22} /></span>
    <h3 class="text-cream !text-lg">{title}</h3>
  </div>
  {value && <p class="mt-3 text-muted">{value}</p>}
  {flag && <Placeholder class="mt-3" note={flag} />}
</article>
