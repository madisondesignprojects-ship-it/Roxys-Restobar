---
// Wordmark (6.8, v2): condensed marquee type, small monochrome record mark. [PLACEHOLDER - business approval of wordmark/favicon]
import { u } from '../lib/site';
interface Props { size?: 'sm' | 'lg'; link?: boolean }
const { size = 'sm', link = true } = Astro.props;
const Tag = link ? 'a' : 'div';
---
<Tag href={link ? u('/') : undefined} class="inline-flex items-center gap-2.5 text-cream no-underline">
  <svg viewBox="0 0 40 40" class={size === 'lg' ? 'h-11 w-11' : 'h-8 w-8'} aria-hidden="true">
    <circle cx="20" cy="20" r="19.5" fill="#050307" stroke="#3A2E49" />
    <circle cx="20" cy="20" r="15.5" fill="none" stroke="#2A2036" /><circle cx="20" cy="20" r="12" fill="none" stroke="#2A2036" />
    <circle cx="20" cy="20" r="7" fill="#8252C8" /><circle cx="20" cy="20" r="1.4" fill="#050307" />
  </svg>
  <span class="flex flex-col leading-none">
    <span class="sr-only">Home: </span>
    <span class={`font-display uppercase tracking-[.02em] ${size === 'lg' ? 'text-4xl' : 'text-[1.6rem]'} leading-[.9]`}>Roxy's</span>
    <span class={`mono uppercase text-muted ${size === 'lg' ? 'text-xs' : 'text-[.6rem]'} mt-1 tracking-[.42em]`}>Restobar</span>
  </span>
</Tag>
