---
// Wordmark (6.8): no logo file exists. [PLACEHOLDER - business approval of wordmark/favicon]
import { u } from '../lib/site';
interface Props { size?: 'sm' | 'lg'; link?: boolean }
const { size = 'sm', link = true } = Astro.props;
const Tag = link ? 'a' : 'div';
---
<Tag href={link ? u('/') : undefined} class="inline-flex items-center gap-2.5 no-underline text-cream">
  <svg viewBox="0 0 40 40" class={size === 'lg' ? 'h-12 w-12' : 'h-9 w-9'} aria-hidden="true">
    <circle cx="20" cy="20" r="19.5" fill="#0d0a12" /><circle cx="20" cy="20" r="16" fill="none" stroke="#3A2C52" />
    <circle cx="20" cy="20" r="12.5" fill="none" stroke="#3A2C52" /><circle cx="20" cy="20" r="8" fill="#E8833A" /><circle cx="20" cy="20" r="1.6" fill="#1A1326" />
  </svg>
  <span class="flex flex-col leading-none"><span class="sr-only">Home: </span>
    <span class={`font-display ${size === 'lg' ? 'text-4xl' : 'text-[1.55rem]'} leading-none`}>ROXY'S</span>
    <span class={`font-black uppercase text-lavender ${size === 'lg' ? 'text-sm' : 'text-[.62rem]'} tracking-[.3em] mt-1`}>Restobar</span>
  </span>
</Tag>
