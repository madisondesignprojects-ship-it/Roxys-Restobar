---
// v2: a hairline rule with a small record in the middle (replaces the cartoon half-record).
interface Props { class?: string; skip?: boolean; label?: string }
const { class: cls = '', skip = false, label } = Astro.props;
---
<div class={`container-x flex items-center gap-4 ${cls}`} aria-hidden="true">
  <span class="rule flex-1"></span>
  <svg viewBox="0 0 40 40" class={`h-7 w-7 shrink-0 ${skip ? 'rotate-[24deg]' : ''}`}>
    <circle cx="20" cy="20" r="19" fill="#050307" stroke="#3A2E49" /><circle cx="20" cy="20" r="14" fill="none" stroke="#2A2036" />
    <circle cx="20" cy="20" r="6" fill="#8252C8" />{skip && <path d="M6 9 L34 31" stroke="#C2412D" stroke-width="1.5" />}
  </svg>
  {label && <span class="eyebrow text-dim">{label}</span>}
  <span class="rule flex-1"></span>
</div>
