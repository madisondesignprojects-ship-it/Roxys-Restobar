---
import { Picture } from 'astro:assets';
import { img, widthsFor } from '../lib/images';
interface Props { src: string; alt: string; sizes?: string; class?: string; pictureClass?: string; eager?: boolean; widths?: number[] }
const { src, alt, sizes = '(min-width:1024px) 33vw, 100vw', class: cls = '', pictureClass = '', eager = false, widths } = Astro.props;
const meta = img(src);
const fallback = meta.format === 'png' ? 'png' : 'jpg';
---
<Picture src={meta} alt={alt} formats={['avif', 'webp']} fallbackFormat={fallback} widths={widthsFor(meta, widths)} sizes={sizes}
  class={cls} pictureAttributes={{ class: pictureClass }} loading={eager ? 'eager' : 'lazy'} decoding={eager ? 'auto' : 'async'}
  fetchpriority={eager ? 'high' : undefined} />
