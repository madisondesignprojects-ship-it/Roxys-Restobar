---
// 7.5 (v2, marquee board): today's or the next event from events.json (dated only) + weekly.json (confirmed only).
// Server-rendered at build time, then refreshed in the browser in America/Chicago time.
import Icon from './Icon.astro';
import { site, datedEvents, confirmedWeekly, TYPE_LABELS, fmtTime, u } from '../lib/site';
import { nextItem } from '../lib/time';
const items = [
  ...confirmedWeekly.map((w) => ({ kind: 'weekly', day: w.day, title: w.title, label: w.label, type: w.type, time: w.time })),
  ...datedEvents.map((e: any) => ({ kind: 'dated', date: e.date, title: e.title, label: '', type: e.type, time: e.time ?? '' })),
].map((i) => ({ ...i, tag: TYPE_LABELS[i.type]?.label ?? '', timeText: i.time ? fmtTime(i.time) : '' }));
const n = nextItem(items);
const first = n?.item;
---
<div class="relative border border-neon/60 bg-[#08060C] p-1 shadow-[0_0_0_1px_rgb(13_9_18),0_0_40px_-10px_rgb(181_124_255/.6)]" data-tonight data-items={JSON.stringify(items)}>
  <div class="border border-rule p-5 md:p-7">
    {first ? (
      <div class="grid items-center gap-5 md:grid-cols-[auto_1fr_auto] md:gap-8">
        <div class="flex items-baseline gap-3 md:flex-col md:items-start md:gap-0 md:border-r md:border-rule md:pr-8">
          <p class="eyebrow neon" data-t-when>{n!.when}</p>
          <p class="mono text-sm uppercase tracking-[.14em] text-muted"><span data-t-dow>{n!.dow}</span> <span data-t-num>{n!.num}</span></p>
        </div>
        <div class="min-w-0">
          <h2 class="!text-4xl text-cream md:!text-5xl" data-t-title>{first.title}</h2>
          <p class="mt-2 eyebrow text-label-gold" data-t-label>{first.label}</p>
        </div>
        <a href={u('/events')} class="link-arrow">All events <Icon name="arrow-right" size={16} /></a>
      </div>
    ) : (
      <div>
        <p class="eyebrow neon">This week</p>
        <p class="mt-2 font-display text-3xl uppercase text-cream">Follow us on Facebook for this week's lineup</p>
        <a href={site.facebook} target="_blank" rel="noopener" class="btn btn-primary mt-4"><Icon name="facebook" size={18} />Follow on Facebook<span class="sr-only"> (opens in new tab)</span></a>
      </div>
    )}
  </div>
</div>
