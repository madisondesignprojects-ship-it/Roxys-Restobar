---
// The old site's "Music Events" list. Year unknown, so it's shown as past/recent.
// strip: setlist (title …… date). Full: VERBATIM original "Title- Date" strings.
import Placeholder from './Placeholder.astro';
import { events, TYPE_LABELS } from '../lib/site';
interface Props { strip?: boolean }
const { strip = false } = Astro.props;
---
{strip ? (
  <div>
    <p class="eyebrow text-dim">Recent setlist · from our old site</p>
    <ol class="mt-4">
      {events.map((e, i) => (
        <li class="flex items-baseline gap-3 border-b border-rule/60 py-2.5">
          <span class="mono w-6 shrink-0 text-xs text-dim">{String(i + 1).padStart(2, '0')}</span>
          <span class="font-display text-xl uppercase text-cream md:text-2xl">{e.title}</span>
          <span class="leader" aria-hidden="true"></span>
          <span class="mono shrink-0 text-xs uppercase tracking-[.12em] text-muted">{e.dateText}</span>
        </li>
      ))}
    </ol>
    <Placeholder class="mt-4" note={events[0].date.replace(/^\[|\]$/g, '') + ' (these dates are from the old site and have no year)'} />
  </div>
) : (
  <ol class="border-t border-rule">
    {events.map((e, i) => (
      <li class="flex flex-wrap items-center gap-x-4 gap-y-1 border-b border-rule px-1 py-3">
        <span class="mono w-6 text-xs text-dim">{String(i + 1).padStart(2, '0')}</span>
        <span class="flex-1 font-semibold text-cream">{e.original}</span>
        <span class={`tag tag-${TYPE_LABELS[e.type].tone}`}>{TYPE_LABELS[e.type].label}</span>
      </li>
    ))}
  </ol>
)}
