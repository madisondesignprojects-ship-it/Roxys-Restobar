---
import Icon from './Icon.astro';
import { site } from '../lib/site';
---
<div class="relative h-[320px] overflow-hidden border border-rule bg-night-2 md:h-[440px]" data-map data-src={site.mapEmbed} data-title="Map to Roxy's Restobar, 208 W Main St, Stoughton">
  <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 p-6 text-center" data-map-card>
    <div class="halftone" aria-hidden="true"></div>
    <svg class="absolute inset-0 h-full w-full opacity-40" aria-hidden="true"><defs><pattern id="mapgrid" width="44" height="44" patternUnits="userSpaceOnUse"><path d="M44 0H0V44" fill="none" stroke="#2A2036" stroke-width="1"/></pattern></defs><rect width="100%" height="100%" fill="url(#mapgrid)"/></svg>
    <span class="relative inline-flex h-12 w-12 shrink-0 items-center justify-center border border-neon text-lavender shadow-[var(--shadow-glow)]"><Icon name="map-pin" size={24} /></span>
    <p class="relative font-display text-2xl uppercase text-cream">{site.address.street}<br />{site.address.city}, {site.address.state} {site.address.zip}</p>
    <p class="relative mono text-xs uppercase tracking-[.14em] text-muted">Plus code {site.plusCode.split(' ')[0]}</p>
    <div class="relative flex flex-wrap justify-center gap-3">
      <button type="button" class="btn btn-outline btn-sm" data-map-load><Icon name="map" size={16} />Show map</button>
      <a href={site.directions} target="_blank" rel="noopener" class="btn btn-primary btn-sm"><Icon name="navigation" size={16} />Directions<span class="sr-only"> (opens in new tab)</span></a>
    </div>
    <p class="relative text-xs text-dim">The map loads from Google when you tap "Show map".</p>
  </div>
</div>
