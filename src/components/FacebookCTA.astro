---
// 7.10: replaces the old 32px icon + "Like Us for Updates" (heading VERBATIM).
import Icon from './Icon.astro';
import Img from './Img.astro';
import Placeholder from './Placeholder.astro';
import { site } from '../lib/site';
interface Props { showArt?: boolean; class?: string }
const { showArt = true, class: cls = '' } = Astro.props;
---
<div class={`relative overflow-hidden border-y border-rule py-10 md:py-14 ${cls}`}>
  <div class="relative grid items-center gap-8 md:grid-cols-[auto_1fr]">
    {showArt && (
      <div class="w-28 shrink-0 md:w-36">
        <Img src="facebook/facebook-profile-picture.jpg" alt="Illustrated Roxy's logo art with a beer, cornhole boards and a dartboard" sizes="144px" widths={[400]} class="aspect-square w-full border border-rule object-cover" />
      </div>
    )}
    <div>
      <p class="eyebrow text-dim">facebook.com/roxysrestobar</p>
      <h2 class="mt-2 text-cream">Like Us for <span class="neon">Updates</span></h2>
      <p class="mt-3 max-w-xl text-muted">Holiday hours and early openings are posted on Facebook.</p>
      <a href={site.facebook} target="_blank" rel="noopener" class="btn btn-primary mt-6"><Icon name="facebook" size={18} />Follow Roxy's on Facebook<span class="sr-only"> (opens in new tab)</span></a>
      {showArt && <Placeholder class="mt-5 max-w-xl" note="official logo file? (Facebook art may be seasonal)" />}
    </div>
  </div>
</div>
