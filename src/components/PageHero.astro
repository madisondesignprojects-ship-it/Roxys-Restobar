---
// v2: photo-led, low-key, big condensed title.
import Img from './Img.astro';
interface Props { title: string; eyebrow?: string; image?: string; imageAlt?: string; pos?: string }
const { title, eyebrow, image, imageAlt = '', pos = '50% 50%' } = Astro.props;
---
<section class="relative overflow-hidden border-b border-rule bg-purple-night">
  {image && <div class="vignette absolute inset-0"><Img src={image} alt={imageAlt} eager sizes="100vw" class="photo h-full w-full object-cover opacity-70" pictureClass="block h-full" style={`object-position:${pos}`} /></div>}
  <div class="halftone opacity-40" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-night via-night/55 to-night/10" aria-hidden="true"></div>
  <div class="relative container-x flex min-h-[260px] flex-col justify-end pb-10 pt-20 md:min-h-[400px] md:pb-14">
    {eyebrow && <p class="eyebrow text-lavender">{eyebrow}</p>}
    <h1 class="mt-3 text-cream">{title}</h1>
    <slot />
  </div>
</section>
